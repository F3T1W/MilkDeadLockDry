@startuml components
title DeadLocky — FSD
skinparam shadowing false
caption DeadLocky.slnx: application + xUnit project; FSD layers inside src/DeadLocky/
package "src/DeadLocky — net10.0-macos / AppKit" {
rectangle "App\nEntryPoint / Composition / Ui" as App
rectangle "Pages\nLauncher/Ui" as Pages
rectangle "Features\nSelectGameDirectory/Model + Ui" as Features
rectangle "Entities\nGame/Model" as Entities
rectangle "Shared\nApi/Directories" as Shared
}
rectangle "tests/DeadLocky.UnitTests\nnet10.0 / xUnit\nNo tests or project reference yet" as Tests
artifact "Directory.Build.props\nC# 14 / nullable / analyzers / warnings as errors" as BuildProps
BuildProps ..> App : shared build settings
BuildProps ..> Tests : shared build settings
App ..> Pages
App ..> Shared : binds native adapter
Pages ..> Features
Pages ..> Shared : picker factory contract
Features ..> Entities
Features ..> Shared : generic I/O port
note bottom of Features
  State → action → Render.
  Slice internals are internal; imports point downwards.
  No MVVM dependency.
end note
@enduml

@startuml classes
title DeadLocky — directory selection
skinparam shadowing false
class LauncherComposition <<App>>
class LauncherWindowController <<Pages.Launcher>>
class SelectGameDirectoryView <<Features public API>> {
  SelectedDirectory : GameDirectory
  SelectionChanged : event
}
class DirectorySelectionController <<Features internal>> {
  State : DirectorySelectionState
  ChooseAsync() : Task
  Clear()
  Dispose()
}
class DirectorySelectionState <<immutable record>>
class GameDirectory <<Entities public API>>
interface IDirectoryPicker <<Shared port>> {
  PickAsync(token) : Task<string?>
}
class AppKitDirectoryPicker <<Shared adapter>>
LauncherComposition --> LauncherWindowController
LauncherComposition --> AppKitDirectoryPicker
LauncherWindowController *-- SelectGameDirectoryView
SelectGameDirectoryView *-- DirectorySelectionController
DirectorySelectionController --> DirectorySelectionState
DirectorySelectionState --> GameDirectory
DirectorySelectionController --> IDirectoryPicker
AppKitDirectoryPicker ..|> IDirectoryPicker
@enduml

@startuml select
actor User
participant SelectGameDirectoryView as View
participant DirectorySelectionController as Action
participant AppKitDirectoryPicker as Picker
participant NSOpenPanel as Panel
User -> View : Choose
View -> Action : ChooseAsync()
Action -> Action : busy = true, clear old error
Action --> View : StateChanged → Render
Action -> Picker : PickAsync(ownerToken)
Picker -> Panel : BeginSheet(owner)
Panel --> Picker : path / user cancel
Picker --> Action : path / null
Action -> Action : update selection, busy = false
Action --> View : StateChanged → Render
note over Action, Picker
  User cancel preserves selection.
  Owner dispose cancels the dialog.
  Failure preserves selection and reports error.
  Retry clears the previous error.
end note
@enduml
